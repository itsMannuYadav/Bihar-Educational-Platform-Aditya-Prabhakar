ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shiksha_sathi

SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# openai | gemini — whichever is set here must have its API key filled in below.
LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Model ids move: gemini-2.5-flash is already retired for new keys. Check
# `client.models.list()` if a call 404s with "no longer available".
GEMINI_MODEL=gemini-3.6-flash
# Free tier is 5 requests/minute; raise this on a paid tier.
LLM_MAX_CONCURRENCY=2
GEMINI_API_KEY=
