{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "apps/web"
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8000", "--reload"],
      "port": 8000,
      "autoPort": false,
      "cwd": "apps/api"
    }
  ]
}
